{
    "name": "survos/the-guardian-bundle",
    "description": "Symfony bundle for interacting with The Guardian API",
    "keywords": [
        "symfony-ux",
        "symfony"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "twig/twig": "^3.4",
        "nonsoniyi/the-guardian-api-client": "^1.0",
        "symfony/form": "^8.1",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/var-dumper": "^8.1",
        "survos/simple-datatables-bundle": "^2.5",
        "symfony/yaml": "^8.1",
        "symfony/http-client": "^8.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Survos\\TheGuardianBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\TheGuardianBundle\\Tests\\": "Tests/"
        }
    },
    "suggest": {
        "survos/simple-datatables-bundle": "searchable/sortable tables when browsing"
    }
}
